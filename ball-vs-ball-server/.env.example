PORT=2568
# Origins allowed to call /api, comma-separated. `*` matches any part of a host,
# e.g. Netlify deploy previews: https://*--ball-vs-ball.netlify.app
CLIENT_ORIGIN=http://localhost:*,https://ball-vs-ball.netlify.app
# Where saved profiles are written. Render's free disk is wiped on every deploy/restart; attach a disk and point this at it to keep them.
DATA_DIR=./data
# Bloxity: the slug the game is registered under on bloxity.io (the client's VITE_GAME_SLUG must match), and the
# secret Bloxity's Gems webhook sends in x-legion-webhook-secret. Point the game's webhook in Bloxity's admin panel
# at https://<this server>/api/bloxity/webhook. Without the secret every Gems purchase is refused (and refunded).
BLOXITY_GAME_SLUG=ball-vs-ball
BLOXITY_WEBHOOK_SECRET=
# BLOXITY_API_URL=https://api.bloxity.io
